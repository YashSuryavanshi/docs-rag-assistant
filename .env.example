# Copy to .env and edit. Every setting in rag/config.py can be set here with the RAG_ prefix.

# Generation (optional). Any OpenAI-compatible endpoint, e.g. your own vLLM server:
#   vllm serve Qwen/Qwen2.5-7B-Instruct --port 8000
# RAG_LLM_BASE_URL=http://localhost:8000/v1
# RAG_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# RAG_LLM_API_KEY=not-needed-for-vllm

# Chunking (see eval/sweep_chunking.py for how to choose these)
# RAG_CHUNK_SIZE=200
# RAG_CHUNK_OVERLAP=40

# Use a Qdrant server instead of the embedded store
# RAG_QDRANT_URL=http://localhost:6333
